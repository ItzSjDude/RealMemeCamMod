// Android.bp for CoreAlgo 8pro

cc_prebuilt_library_shared {
    name: "libAlgoProcess",
    owner: "oplus",
    strip: { none: true },
    multilib: {
        lib64: { srcs: ["libs/lib64/libAlgoProcess.so"] },
        lib32: { srcs: ["libs/lib/libAlgoProcess.so"] },
    },
    compile_multilib: "both",
    check_elf_files: false,
    prefer: true,
    device_specific: true,
    shared_libs: [
        "libm",
        "libdl",
        "libion",
        "libnativewindow",
        "libutils",
        "vendor.qti.hardware.camera.postproc@1.0",
        "libc++",
        "libc",
        "libGLESv3",
        "libhidlbase",
        "libcutils",
        "vendor.oplus.hardware.orms@1.0",
        "libmpbase",
        "libEGL",
        "libqdMetaData",
        "liblog",
        "libapsexif",
        "libapsjpeg",
        "libormshalclient",
    ],
}

