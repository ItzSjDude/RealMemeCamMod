soong_namespace {
    imports: ["vendor/realmeme_cam_mod"],
}

java_library {
    name: "com.oplus.camera.unit.sdk",
    srcs: ["com.oplus.camera.unit.sdk/src/**/*.java"],
    installable: true,
    libs: ["framework", "oplus-framework"],
    static_libs: ["androidx.annotation_annotation"],
    system_ext_specific: true,
}

prebuilt_etc {
    name: "com.oplus.camera.unit.sdk.xml",
    src: "com.oplus.camera.unit.sdk.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}
